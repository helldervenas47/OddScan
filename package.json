{
  "name": "oddscan-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@oddscan/web",
    "worker:dev": "npm run dev --workspace=@oddscan/worker",
    "worker:run": "npm run run:once --workspace=@oddscan/worker",
    "build": "cd apps/web && npx vite build",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
